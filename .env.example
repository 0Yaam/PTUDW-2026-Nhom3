# Local Docker Compose defaults. Copy to .env and replace for shared environments.
POSTGRES_DB=culinary_blog
POSTGRES_USER=culinary
POSTGRES_PASSWORD=replace-with-a-local-db-password
MINIO_ACCESS_KEY=culinary
MINIO_SECRET_KEY=replace-with-a-long-local-secret
MINIO_BUCKET=culinary-blog
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=http://localhost:9000
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM=no-reply@culinary.local
APP_PUBLIC_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
REDIS_URL=redis://redis:6379/0
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=80
